#!/usr/bin/env bash
# Compares cleanup settings on the transcripts in bench/cleanup. Each setting cleans every
# transcript RUNS times; the script prints the median latency per setting and saves each output
# for reading side by side. Needs ANTHROPIC_API_KEY like the daemon, and costs a few cents.
#
#   scripts/bench-cleanup [RUNS] [OUT_DIR]
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
runs=${1:-3}
out=${2:-$(mktemp -d /tmp/pickscribe-bench.XXXX)}
bin=${PICKSCRIBE_BIN:-pickscribe}
settings=("low" "medium" "high" "low --thinking" "medium --thinking")

median() { sort -n | awk '{ v[NR] = $1 } END { print v[int((NR + 1) / 2)] }'; }

printf '%-20s %10s %10s\n' setting median_ms max_ms
for setting in "${settings[@]}"; do
  name=${setting// --thinking/-thinking}
  mkdir -p "$out/$name"
  times=()
  for fixture in "$repo"/bench/cleanup/*.txt; do
    base=$(basename "$fixture" .txt)
    for run in $(seq "$runs"); do
      start=$(date +%s%N)
      # shellcheck disable=SC2086
      "$bin" clean --effort $setting <"$fixture" >"$out/$name/$base.$run.txt" 2>/dev/null \
        || echo "FAILED" >"$out/$name/$base.$run.txt"
      times+=($(( ($(date +%s%N) - start) / 1000000 )))
    done
  done
  printf '%-20s %10s %10s\n' "$name" \
    "$(printf '%s\n' "${times[@]}" | median)" "$(printf '%s\n' "${times[@]}" | sort -n | tail -1)"
done
echo "outputs: $out"
